# Copy to .env and edit. .env is gitignored.

# Image to run, if not the one that compose.yml names (the image that the bundle came
# from). `make build` builds this tag locally.
# QCSC_CLUSTER_IMAGE=quay.io/boseong14/qcsc-slurm-cluster:latest

# Ports of the login node on 127.0.0.1: SSH (optional, after `make add-key`) and
# JupyterLab (optional, `make jupyter`).
SSH_PORT=2222
JUPYTER_PORT=8888

# Size of each compute node (c1 and c2). Slurm advertises QCSC_NODE_CPUS and
# QCSC_NODE_MEMORY_MB; keep QCSC_NODE_MEMORY_MB below QCSC_NODE_MEM_LIMIT.
# These apply when /etc/slurm is first seeded; after that, edit slurm.conf in the
# etc_slurm volume or run `make clean`.
QCSC_NODE_CPUS=4
QCSC_NODE_MEMORY_MB=7000
QCSC_NODE_MEM_LIMIT=8g

# Public keys for the qcsc user, one per line (or use `make add-key`). Only for SSH.
# QCSC_AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@laptop"

# qcsc-prefect branch or tag that `make build` preinstalls.
# QCSC_PREFECT_REF=main
